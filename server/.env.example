# 复制成 .env 再填写（.env 不要提交到代码仓库）。
PORT=3030
# 放在 Nginx 后面填 127.0.0.1：外网不能绕过 Nginx 直连端口（限流依赖 Nginx 传来的访客 IP）
HOST=127.0.0.1
# 页面挂在哪个路径下；Nginx 把 /1030/api/ 和 /1030/avatars/ 原样转发过来
PREFIX=/1030

# ---- 火山方舟 / 豆包 Seedream（只放在服务器上）----
AI_PROVIDER=ark
ARK_API_KEY=
ARK_MODEL=doubao-seedream-5-0-flash-260915
ARK_SIZE=1K

# 本地联调不花钱：固定返回 MOCK_IMAGE 这张图
# AI_PROVIDER=mock
# MOCK_IMAGE=mock_avatar.png
# 本地预览时顺便提供静态页面（线上由 Nginx 提供，不要填）
# STATIC_DIR=..

# ---- 防刷与成本控制 ----
# 按 IP 计：活动现场 Wi-Fi 下很多手机共用一个 IP，别设太小
GEN_PER_HOUR=20
GEN_PER_DAY=1000
POST_PER_HOUR=12

# ---- 集合页管理：打开 /1030/admin.html 输入这个口令，可删除不合适的形象 ----
ADMIN_TOKEN=
